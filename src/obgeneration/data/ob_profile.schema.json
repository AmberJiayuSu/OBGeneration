{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "OB Profile Schema",
    "type": "object",
    "description": "Input profile consumed by obgeneration.model.Occupant.from_json_file for stochastic residential occupant-behavior schedule generation.",
    "$defs": {
        "TimeRange": {
            "type": "object",
            "description": "A time range with fractional start and end hours in [0, 24). Wraps midnight when end_hour < start_hour.",
            "properties": {
                "start_hour": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 24,
                    "default": 0,
                    "description": "Hour of day when the interval starts."
                },
                "end_hour": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 24,
                    "default": 0,
                    "description": "Hour of day when the interval ends."
                }
            },
            "required": [
                "start_hour",
                "end_hour"
            ]
        },
        "NumberRange": {
            "type": "object",
            "description": "Inclusive integer range used for weekly event frequencies.",
            "properties": {
                "min": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                },
                "max": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                }
            },
            "required": [
                "min",
                "max"
            ]
        },
        "ScheduleRigidness": {
            "type": "string",
            "description": "How consistently a time pattern is followed. Maps to a start/end time standard deviation in the generator.",
            "enum": [
                "highly_variable",
                "somewhat_variable",
                "mostly_consistent",
                "strict"
            ]
        },
        "MobilityCluster": {
            "type": "string",
            "description": "Daily mobility pattern for a single occupant, mapping to an ATUS Markov-chain cluster.",
            "enum": [
                "mostly_home",
                "long_day_away",
                "morning_away",
                "afternoon_away",
                "evening_night_away"
            ]
        },
        "OccupantMobilityProfile": {
            "type": "object",
            "description": "Weekday and weekend mobility cluster assignment for a single occupant.",
            "properties": {
                "weekday_cluster": {
                    "$ref": "#/$defs/MobilityCluster"
                },
                "weekend_cluster": {
                    "$ref": "#/$defs/MobilityCluster"
                }
            },
            "required": [
                "weekday_cluster",
                "weekend_cluster"
            ]
        },
        "HouseholdComposition": {
            "type": "object",
            "description": "Per-occupant mobility cluster assignments. The occupants length should equal occupancy.num_occupants.",
            "properties": {
                "occupants": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/OccupantMobilityProfile"
                    },
                    "minItems": 1
                }
            },
            "required": [
                "occupants"
            ]
        },
        "WeekdayOccupancyPattern": {
            "type": "object",
            "description": "Optional weekday household-away pattern used to post-process the Markov occupancy states.",
            "properties": {
                "is_always_occupied": {
                    "type": "boolean"
                },
                "away_interval": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TimeRange"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "num_of_days": {
                    "anyOf": [
                        {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 5
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "away_time_rigidness": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ScheduleRigidness"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "required": [
                "is_always_occupied"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "is_always_occupied": {
                                "const": false
                            }
                        },
                        "required": [
                            "is_always_occupied"
                        ]
                    },
                    "then": {
                        "required": [
                            "away_interval"
                        ],
                        "properties": {
                            "away_interval": {
                                "$ref": "#/$defs/TimeRange"
                            }
                        }
                    }
                }
            ]
        },
        "WeekendOccupancyPattern": {
            "type": "object",
            "description": "Optional weekend household-away pattern used to post-process the Markov occupancy states.",
            "properties": {
                "is_always_occupied": {
                    "type": "boolean"
                },
                "away_interval": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TimeRange"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "away_time_rigidness": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ScheduleRigidness"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "required": [
                "is_always_occupied"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "is_always_occupied": {
                                "const": false
                            }
                        },
                        "required": [
                            "is_always_occupied"
                        ]
                    },
                    "then": {
                        "required": [
                            "away_interval"
                        ],
                        "properties": {
                            "away_interval": {
                                "$ref": "#/$defs/TimeRange"
                            }
                        }
                    }
                }
            ]
        },
        "SleepPattern": {
            "type": "object",
            "description": "Optional household sleep pattern used to post-process the Markov occupancy states.",
            "properties": {
                "is_always_awake": {
                    "type": "boolean"
                },
                "sleep_time": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TimeRange"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "sleep_time_rigidness": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ScheduleRigidness"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "required": [
                "is_always_awake"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "is_always_awake": {
                                "const": false
                            }
                        },
                        "required": [
                            "is_always_awake"
                        ]
                    },
                    "then": {
                        "required": [
                            "sleep_time"
                        ],
                        "properties": {
                            "sleep_time": {
                                "$ref": "#/$defs/TimeRange"
                            }
                        }
                    }
                }
            ]
        },
        "Occupancy": {
            "type": "object",
            "description": "Household occupancy profile.",
            "properties": {
                "num_occupants": {
                    "type": "integer",
                    "minimum": 1
                },
                "household_composition": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/HouseholdComposition"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "weekday_pattern": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/WeekdayOccupancyPattern"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "weekend_pattern": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/WeekendOccupancyPattern"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "sleep_pattern": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/SleepPattern"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "required": [
                "num_occupants",
                "household_composition"
            ]
        },
        "Lighting": {
            "type": "object",
            "description": "Household lighting profile.",
            "properties": {
                "if_led": {
                    "type": "boolean",
                    "description": "Whether the household uses LED lighting."
                },
                "when_away": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether lighting remains on when occupants are away."
                },
                "when_daylight_bright": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether lighting is adjusted when daylight is bright."
                }
            },
            "required": [
                "if_led"
            ]
        },
        "IntensityLevel": {
            "type": "string",
            "description": "Valve intensity level.",
            "enum": [
                "minimum",
                "low",
                "medium",
                "high",
                "fullon"
            ]
        },
        "NoControl": {
            "type": "object",
            "description": "No occupant control; system runs on building logic.",
            "properties": {
                "type": {
                    "const": "no_control",
                    "default": "no_control"
                }
            },
            "required": [
                "type"
            ]
        },
        "BinaryControl": {
            "type": "object",
            "description": "Occupants control whether the system is on or off for active, sleep, and absent states.",
            "properties": {
                "type": {
                    "const": "binary",
                    "default": "binary"
                },
                "active_state": {
                    "type": "boolean"
                },
                "sleep_state": {
                    "type": "boolean"
                },
                "absent_state": {
                    "type": "boolean"
                }
            },
            "required": [
                "type",
                "active_state",
                "sleep_state",
                "absent_state"
            ]
        },
        "ValveControl": {
            "type": "object",
            "description": "Heating valve control. Valid only for heating systems.",
            "properties": {
                "type": {
                    "const": "valve",
                    "default": "valve"
                },
                "active_level": {
                    "$ref": "#/$defs/IntensityLevel"
                },
                "sleep_level": {
                    "$ref": "#/$defs/IntensityLevel"
                },
                "absent_level": {
                    "$ref": "#/$defs/IntensityLevel"
                }
            },
            "required": [
                "type",
                "active_level",
                "sleep_level",
                "absent_level"
            ]
        },
        "ThermostatControl": {
            "type": "object",
            "description": "Thermostat setpoint control in degrees C. Null setpoints represent off/unset states.",
            "properties": {
                "type": {
                    "const": "thermostat",
                    "default": "thermostat"
                },
                "active_setpoint": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "sleep_setpoint": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "absent_setpoint": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "required": [
                "type"
            ]
        },
        "HeatingSystem": {
            "oneOf": [
                {
                    "$ref": "#/$defs/NoControl"
                },
                {
                    "$ref": "#/$defs/BinaryControl"
                },
                {
                    "$ref": "#/$defs/ValveControl"
                },
                {
                    "$ref": "#/$defs/ThermostatControl"
                }
            ]
        },
        "CoolingSystem": {
            "oneOf": [
                {
                    "$ref": "#/$defs/NoControl"
                },
                {
                    "$ref": "#/$defs/BinaryControl"
                },
                {
                    "$ref": "#/$defs/ThermostatControl"
                }
            ]
        },
        "HVAC": {
            "type": "object",
            "description": "Heating and cooling control profile. Either system may be null or omitted.",
            "properties": {
                "heating": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/HeatingSystem"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": {
                        "type": "thermostat",
                        "active_setpoint": 22,
                        "sleep_setpoint": 21,
                        "absent_setpoint": 20
                    }
                },
                "cooling": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/CoolingSystem"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            }
        },
        "WindowOpeningBehavior": {
            "type": "string",
            "enum": [
                "frequently_open",
                "occasionally_open",
                "always_closed"
            ]
        },
        "Window": {
            "type": "object",
            "description": "Window operation profile. Season fields may be null or omitted.",
            "properties": {
                "heating_season": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/WindowOpeningBehavior"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "cooling_season": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/WindowOpeningBehavior"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "shoulder_season": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/WindowOpeningBehavior"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            }
        },
        "FuelType": {
            "type": "string",
            "enum": [
                "electric",
                "gas",
                "other"
            ]
        },
        "DishwashingPattern": {
            "type": "string",
            "enum": [
                "after_each_cooked_meal",
                "daily_batch_if_cooked",
                "whenever_full",
                "independent_frequency"
            ]
        },
        "DishwashingLogic": {
            "type": "object",
            "description": "Behavioral pattern and optional frequency range for dishwasher events.",
            "properties": {
                "pattern_type": {
                    "$ref": "#/$defs/DishwashingPattern",
                    "default": "daily_batch_if_cooked"
                },
                "usage_frequency_per_week": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/NumberRange"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "pattern_type": {
                                "const": "independent_frequency"
                            }
                        },
                        "required": [
                            "pattern_type"
                        ]
                    },
                    "then": {
                        "required": [
                            "usage_frequency_per_week"
                        ],
                        "properties": {
                            "usage_frequency_per_week": {
                                "$ref": "#/$defs/NumberRange"
                            }
                        }
                    }
                }
            ]
        },
        "LaundryEquipment": {
            "type": "object",
            "description": "Laundry appliance profile.",
            "properties": {
                "has_washer": {
                    "type": "boolean",
                    "default": true
                },
                "washer_efficient": {
                    "type": "boolean",
                    "default": true
                },
                "has_dryer": {
                    "type": "boolean",
                    "default": false
                },
                "dryer_efficient": {
                    "type": "boolean",
                    "default": true
                },
                "usage_frequency_per_week": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/NumberRange"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "allOf": [
                {
                    "if": {
                        "not": {
                            "properties": {
                                "has_washer": {
                                    "const": false
                                },
                                "has_dryer": {
                                    "const": false
                                }
                            },
                            "required": [
                                "has_washer",
                                "has_dryer"
                            ]
                        }
                    },
                    "then": {
                        "required": [
                            "usage_frequency_per_week"
                        ],
                        "properties": {
                            "usage_frequency_per_week": {
                                "$ref": "#/$defs/NumberRange"
                            }
                        }
                    }
                }
            ]
        },
        "RefrigerationEquipment": {
            "type": "object",
            "description": "Refrigerator appliance profile.",
            "properties": {
                "has_refrigerator": {
                    "type": "boolean",
                    "default": true
                },
                "efficient_refrigerator": {
                    "type": "boolean",
                    "default": true
                },
                "number_of_refrigerators": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 1
                }
            }
        },
        "DishwasherEquipment": {
            "type": "object",
            "description": "Dishwasher appliance profile.",
            "properties": {
                "has_dishwasher": {
                    "type": "boolean",
                    "default": false
                },
                "dishwasher_efficient": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the dishwasher is efficient. This is the current model field name."
                },
                "dishwashing_operational_logic": {
                    "$ref": "#/$defs/DishwashingLogic",
                    "default": {
                        "pattern_type": "daily_batch_if_cooked",
                        "usage_frequency_per_week": null
                    }
                }
            }
        },
        "CookingEquipment": {
            "type": "object",
            "description": "Cooking appliance profile.",
            "properties": {
                "has_cooking_products": {
                    "type": "boolean",
                    "default": true
                },
                "cooking_products_fuel": {
                    "$ref": "#/$defs/FuelType",
                    "default": "electric"
                },
                "usage_frequency_per_week": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/NumberRange"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "allOf": [
                {
                    "if": {
                        "not": {
                            "properties": {
                                "has_cooking_products": {
                                    "const": false
                                }
                            },
                            "required": [
                                "has_cooking_products"
                            ]
                        }
                    },
                    "then": {
                        "required": [
                            "usage_frequency_per_week"
                        ],
                        "properties": {
                            "usage_frequency_per_week": {
                                "$ref": "#/$defs/NumberRange"
                            }
                        }
                    }
                }
            ]
        },
        "Equipment": {
            "type": "object",
            "description": "Household equipment profile. Subsections are required for profiles intended to run through the schedule generator.",
            "properties": {
                "laundry": {
                    "$ref": "#/$defs/LaundryEquipment",
                    "default": {
                        "has_washer": true,
                        "washer_efficient": true,
                        "has_dryer": false,
                        "dryer_efficient": true,
                        "usage_frequency_per_week": null
                    }
                },
                "refrigerator": {
                    "$ref": "#/$defs/RefrigerationEquipment",
                    "default": {
                        "has_refrigerator": true,
                        "efficient_refrigerator": true,
                        "number_of_refrigerators": 1
                    }
                },
                "dishwasher": {
                    "$ref": "#/$defs/DishwasherEquipment",
                    "default": {
                        "has_dishwasher": false,
                        "dishwasher_efficient": true,
                        "dishwashing_operational_logic": {
                            "pattern_type": "daily_batch_if_cooked",
                            "usage_frequency_per_week": null
                        }
                    }
                },
                "cooking_products": {
                    "$ref": "#/$defs/CookingEquipment",
                    "default": {
                        "has_cooking_products": true,
                        "cooking_products_fuel": "electric",
                        "usage_frequency_per_week": null
                    }
                }
            },
            "required": [
                "laundry",
                "refrigerator",
                "dishwasher",
                "cooking_products"
            ]
        },
        "Meta": {
            "type": "object",
            "description": "Optional metadata ignored by the current Pydantic loader.",
            "properties": {
                "source": {
                    "type": "string",
                    "description": "Source label for the profile, for example user_reported, recs/census_imputed, mixed, or test_input."
                },
                "date": {
                    "type": "string",
                    "format": "date",
                    "description": "Profile creation or update date in YYYY-MM-DD format."
                },
                "zip_code": {
                    "type": "string",
                    "pattern": "^[0-9]{5}$",
                    "description": "Optional household ZIP code."
                }
            }
        }
    },
    "properties": {
        "meta": {
            "$ref": "#/$defs/Meta"
        },
        "occupancy": {
            "$ref": "#/$defs/Occupancy"
        },
        "lighting": {
            "$ref": "#/$defs/Lighting"
        },
        "equipment": {
            "$ref": "#/$defs/Equipment",
            "default": {}
        },
        "hvac": {
            "$ref": "#/$defs/HVAC",
            "default": {}
        },
        "window": {
            "$ref": "#/$defs/Window",
            "default": {}
        }
    },
    "required": [
        "occupancy",
        "lighting",
        "equipment"
    ]
}
