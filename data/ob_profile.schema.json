{
    "title": "OB Profile Schema",
    "type": "object",
    "description": "The profile of occupant behavior in an household for stochastic schedule generation.",
    "properties": {
        "occupancy": {
            "type": "object",
            "description": "The occupancy of the household (number of occupants, household composition, occupancy patterns).",
            "properties": {
                "num_occupants": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The number of occupants in the household."
                },
                "household_composition": {
                    "type": "object",
                    "description": "The composition of the household based on daily mobility patterns.",
                    "properties": {
                        "daily_commuter": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of adults who COMMUTE to a workplace 5 days a week (excludes remote workers)."
                        },
                        "hybrid_worker": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of adults who commute to a workplace 1-4 days a week."
                        },
                        "stayathome": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of people home most of the day (e.g., full-time remote workers, retirees, stay-at-home parents, infants not in daycare)."
                        },
                        "k12_or_daycare": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of children attending school or daycare daily (regular away-from-home schedule)."
                        },
                        "college_student": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of college students (typically irregular/variable schedules)."
                        }
                    }
                },
                "weekday_pattern": {
                    "type": "object",
                    "description": "Defines the unoccupied patterns for weekdays. Any weekdays NOT covered by the primary or secondary intervals are assumed to be occupied (home).",
                    "properties": {
                        "is_always_occupied": {
                            "type": "boolean",
                            "description": "Indicates if the household is typically occupied by at least one person throughout ALL weekdays (e.g. retirees)."
                        },
                        "away_interval": {
                            "type": "object",
                            "description": "If NOT always occupied: The time range when the house is empty.",
                            "properties": {
                                "start_hour": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 23,
                                    "description": "Hour (0-23) when the last person leaves."
                                },
                                "end_hour": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 23,
                                    "description": "Hour (0-23) when the first person returns."
                                }
                            },
                            "required": [
                                "start_hour",
                                "end_hour"
                            ]
                        },
                        "num_of_days": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 5,
                            "description": "Number of weekdays (1-5) the away interval applies to."
                        }
                    },
                    "required": [
                        "is_always_occupied"
                    ]
                },
                "weekend_pattern": {
                    "type": "object",
                    "description": "Defines the unoccupied patterns for weekends.",
                    "properties": {
                        "is_always_occupied": {
                            "type": "boolean",
                            "description": "Indicates if the household is typically occupied by at least one person throughout the entire weekend."
                        },
                        "away_interval": {
                            "type": "object",
                            "description": "If NOT always occupied: The time range when the house is empty.",
                            "properties": {
                                "start_hour": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 23,
                                    "description": "Hour (0-23) when the last person leaves."
                                },
                                "end_hour": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 23,
                                    "description": "Hour (0-23) when the first person returns."
                                }
                            },
                            "required": [
                                "start_hour",
                                "end_hour"
                            ]
                        }
                    },
                    "required": [
                        "is_always_occupied"
                    ]
                },
                "sleep_time": {
                    "type": "object",
                    "description": "Typical sleep time range for the household (applies to both weekdays and weekends).",
                    "properties": {
                        "start_hour": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23,
                            "description": "Hour of the day (0-23) when the latest occupant typically goes to sleep."
                        },
                        "end_hour": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23,
                            "description": "Hour of the day (0-23) when the earliest occupant typically wakes up."
                        }
                    },
                    "required": [
                        "starxst_hour",
                        "end_hour"
                    ]
                }
            },
            "required": [
                "num_occupants",
                "household_composition",
                "sleep_time"
            ]
        },
        "lighting": {
            "type": "object",
            "description": "The lighting usage profile of the household.",
            "properties": {
                "when_daylight_bright": {
                    "type": "boolean",
                    "description": "TRUE if lights are turned off when natural daylight is sufficient."
                }
            },
            "required": [
                "when_daylight_bright"
            ]
        },
        "hvac": {
            "type": "object",
            "description": "The HVAC usage profile of the household.",
            "properties": {
                "heating": {
                    "description": "Heating system control configuration. Can be null if no heating exists.",
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "description": "Type 1: No Occupant Control. System runs on building logic.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "no_control"
                                }
                            },
                            "required": [
                                "type"
                            ]
                        },
                        {
                            "description": "Type 2: Binary Control. Occupant turns system ON or OFF.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "binary"
                                },
                                "active_state": {
                                    "type": "boolean",
                                    "description": "System ON/OFF when occupants are active."
                                },
                                "sleep_state": {
                                    "type": "boolean",
                                    "description": "System ON/OFF during sleep."
                                },
                                "absent_state": {
                                    "type": "boolean",
                                    "description": "System ON/OFF when absent."
                                }
                            },
                            "required": [
                                "type",
                                "active_state",
                                "sleep_state",
                                "absent_state"
                            ]
                        },
                        {
                            "description": "Type 3: Valve Control. Occupant sets intensity level.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "valve"
                                },
                                "active_level": {
                                    "type": "string",
                                    "enum": [
                                        "minimum",
                                        "low",
                                        "medium",
                                        "high",
                                        "fullon"
                                    ],
                                    "description": "Intensity level when occupants are active: off (frost prevention*), low (~25%), medium (~50%), high (~75%), fullon (100%)"
                                },
                                "sleep_level": {
                                    "type": "string",
                                    "enum": [
                                        "minimum",
                                        "low",
                                        "medium",
                                        "high",
                                        "fullon"
                                    ],
                                    "description": "Intensity level during sleep: off (frost prevention*), low (~25%), medium (~50%), high (~75%), fullon (100%)"
                                },
                                "absent_level": {
                                    "type": "string",
                                    "enum": [
                                        "minimum",
                                        "low",
                                        "medium",
                                        "high",
                                        "fullon"
                                    ],
                                    "description": "Intensity level when absent: off (frost prevention*), low (~25%), medium (~50%), high (~75%), fullon (100%)"
                                }
                            },
                            "required": [
                                "type",
                                "active_level",
                                "sleep_level",
                                "absent_level"
                            ]
                        },
                        {
                            "description": "Type 4: Thermostat Control. Occupant sets temperature targets.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "thermostat"
                                },
                                "active_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                },
                                "sleep_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                },
                                "absent_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                }
                            },
                            "required": [
                                "type",
                                "active_setpoint",
                                "sleep_setpoint",
                                "absent_setpoint"
                            ]
                        }
                    ]
                },
                "cooling": {
                    "description": "Cooling system control configuration. Can be null if no cooling exists.",
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "description": "Type 1: No Occupant Control.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "no_control"
                                }
                            },
                            "required": [
                                "type"
                            ]
                        },
                        {
                            "description": "Type 2: Binary Control. Occupant turns system ON or OFF.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "binary"
                                },
                                "active_state": {
                                    "type": "boolean",
                                    "description": "System ON/OFF when occupants are active."
                                },
                                "sleep_state": {
                                    "type": "boolean",
                                    "description": "System ON/OFF during sleep."
                                },
                                "absent_state": {
                                    "type": "boolean",
                                    "description": "System ON/OFF when absent."
                                }
                            },
                            "required": [
                                "type",
                                "active_state",
                                "sleep_state",
                                "absent_state"
                            ]
                        },
                        {
                            "description": "Type 3: Thermostat Control. Occupant sets temperature targets.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "thermostat"
                                },
                                "active_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                },
                                "sleep_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                },
                                "absent_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                }
                            },
                            "required": [
                                "type",
                                "active_setpoint",
                                "sleep_setpoint",
                                "absent_setpoint"
                            ]
                        }
                    ]
                }
            }
        },
        "window": {
            "type": "object",
            "description": "The window operation profile of the household.",
            "properties": {
                "heating_season": {
                    "type": "string",
                    "description": "Indicates the window operation behavior during the heating season.",
                    "enum": [
                        "frequently_open",
                        "occasionally_open",
                        "always_closed"
                    ]
                },
                "cooling_season": {
                    "type": "string",
                    "description": "Indicates the window operation behavior during the cooling season.",
                    "enum": [
                        "frequently_open",
                        "occasionally_open",
                        "always_closed"
                    ]
                },
                "shoulder_season": {
                    "type": "string",
                    "description": "Indicates the window operation behavior during the shoulder seasons (spring and fall).",
                    "enum": [
                        "frequently_open",
                        "occasionally_open",
                        "always_closed"
                    ]
                }
            },
            "required": [
                "heating_season",
                "cooling_season",
                "shoulder_season"
            ]
        },
        "equipment": {
            "type": "object",
            "description": "The equipment usage profile of the household.",
            "properties": {
                "laundry": {
                    "type": "object",
                    "description": "Laundry usage profile.",
                    "properties": {
                        "has_washer": {
                            "type": "boolean",
                            "description": "Indicates whether the household has a washer."
                        },
                        "washer_efficient": {
                            "type": "boolean",
                            "description": "Indicates whether the household has an efficient washer."
                        },
                        "has_dryer": {
                            "type": "boolean",
                            "description": "Indicates whether the household has a dryer."
                        },
                        "dryer_efficient": {
                            "type": "boolean",
                            "description": "Indicates whether the household has an efficient dryer."
                        },
                        "usage_frequency_per_week": {
                            "type": "object",
                            "description": "Frequency of laundry usage per week.",
                            "properties": {
                                "min": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Lower bound of laundry usage frequency per week."
                                },
                                "max": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Upper bound of laundry usage frequency per week."
                                }
                            }
                        }
                    },
                    "required": [
                        "has_washer",
                        "has_dryer"
                    ]
                },
                "refrigerator": {
                    "type": "object",
                    "description": "Refrigerator usage profile.",
                    "properties": {
                        "has_refrigerator": {
                            "type": "boolean",
                            "description": "Indicates whether the household has a refrigerator."
                        },
                        "efficient_refrigerator": {
                            "type": "boolean",
                            "description": "Indicates whether the household has an efficient refrigerator."
                        },
                        "number_of_refrigerators": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of refrigerators in the household."
                        }
                    },
                    "required": [
                        "has_refrigerator"
                    ]
                },
                "dishwasher": {
                    "type": "object",
                    "description": "Dishwasher usage profile.",
                    "properties": {
                        "has_dishwasher": {
                            "type": "boolean",
                            "description": "Indicates whether the household has a dishwasher."
                        },
                        "efficient_dishwasher": {
                            "type": "boolean",
                            "description": "Indicates whether the household has an efficient dishwasher."
                        },
                        "dishwashing_operational_logic": {
                            "type": "object",
                            "description": "Captures the behavioral pattern and frequency of dishwashing activity.",
                            "properties": {
                                "pattern_type": {
                                    "type": "string",
                                    "description": "The primary behavioral logic governing when dishes are washed.",
                                    "enum": [
                                        "after_each_cooked_meal",
                                        "daily_batch_if_cooked",
                                        "whenever_full",
                                        "independent_frequency"
                                    ]
                                },
                                "usage_frequency_per_week": {
                                    "type": "object",
                                    "description": "frequency of dishwasher usage per week (required if pattern_type is 'independent_frequency').",
                                    "properties": {
                                        "min": {
                                            "type": "integer",
                                            "minimum": 0,
                                            "description": "Lower bound of dishwasher usage frequency per week."
                                        },
                                        "max": {
                                            "type": "integer",
                                            "minimum": 0,
                                            "description": "Upper bound of dishwasher usage frequency per week."
                                        }
                                    }
                                }
                            },
                            "required": [
                                "pattern_type"
                            ]
                        }
                    },
                    "required": [
                        "has_dishwasher"
                    ]
                },
                "cooking_products": {
                    "type": "object",
                    "description": "cooking products equipment usage profile.",
                    "properties": {
                        "has_cooking_products": {
                            "type": "boolean",
                            "description": "Indicates whether the household has cooking products (cooktop + oven)."
                        },
                        "cooking_products_fuel": {
                            "type": "string",
                            "description": "Fuel type of the cooking products.",
                            "enum": [
                                "electric",
                                "gas",
                                "other"
                            ]
                        },
                        "usage_frequency_per_week": {
                            "type": "object",
                            "description": "Frequency of cooking products usage per week.",
                            "properties": {
                                "min": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Lower bound of cooking products usage frequency per week."
                                },
                                "max": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Upper bound of cooking products usage frequency per week."
                                }
                            }
                        }
                    },
                    "required": [
                        "has_cooking_products"
                    ]
                }
            }
        }
    }
}