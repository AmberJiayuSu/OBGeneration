{
    "title": "OB Profile Schema",
    "type": "object",
    "description": "The profile of occupant behavior in an household for stochastic schedule generation.",
    "properties": {
        "occupancy": {
            "type": "object",
            "description": "The occupancy of the household (number of occupants, household composition, occupancy patterns).",
            "properties": {
                "num_occupants": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The number of occupants in the household."
                },
                "household_composition": {
                    "type": "object",
                    "description": "The composition of the household based on daily mobility patterns.",
                    "properties": {
                        "daily_commuter": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of adults who COMMUTE to a workplace 5 days a week (excludes remote workers)."
                        },
                        "hybrid_worker": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of adults who commute to a workplace 1-4 days a week."
                        },
                        "stayathome": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of people home most of the day (e.g., full-time remote workers, retirees, stay-at-home parents, infants not in daycare)."
                        },
                        "k12_or_daycare": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of children attending school or daycare daily (regular away-from-home schedule)."
                        },
                        "college_student": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of college students (typically irregular/variable schedules)."
                        }
                    }
                },
                "weekday_pattern": {
                    "type": "object",
                    "description": "Defines the unoccupied patterns for weekdays. Any weekdays NOT covered by the primary or secondary intervals are assumed to be occupied (home).",
                    "properties": {
                        "is_always_occupied": {
                            "type": "boolean",
                            "description": "Indicates if the household is typically occupied by at least one person throughout ALL weekdays (e.g. retirees)."
                        },
                        "away_interval": {
                            "type": "object",
                            "description": "The most frequent time range when the house is empty (e.g., normal commute days).",
                            "properties": {
                                "num_of_days": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 5,
                                    "description": "Number of weekdays (1-5) this primary away interval applies to."
                                },
                                "start_hour": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 23,
                                    "description": "Hour (0-23) when the last person leaves."
                                },
                                "end_hour": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 23,
                                    "description": "Hour (0-23) when the first person returns."
                                }
                            },
                            "required": [
                                "num_of_days",
                                "start_hour",
                                "end_hour"
                            ]
                        }
                    },
                    "required": [
                        "is_always_occupied"
                    ]
                },
                "weekend_pattern": {
                    "type": "object",
                    "description": "Defines the unoccupied patterns for weekends.",
                    "properties": {
                        "is_always_occupied": {
                            "type": "boolean",
                            "description": "Indicates if the household is typically occupied by at least one person throughout the entire weekend."
                        },
                        "away_interval": {
                            "type": "object",
                            "description": "If NOT always occupied: The time range when the house is empty.",
                            "properties": {
                                "start_hour": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 23,
                                    "description": "Hour (0-23) when the last person leaves."
                                },
                                "end_hour": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 23,
                                    "description": "Hour (0-23) when the first person returns."
                                }
                            },
                            "required": [
                                "start_hour",
                                "end_hour"
                            ]
                        }
                    },
                    "required": [
                        "is_always_occupied"
                    ]
                },
                "sleep_time": {
                    "type": "object",
                    "description": "Typical sleep time range for the household (applies to both weekdays and weekends).",
                    "properties": {
                        "start_hour": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23,
                            "description": "Hour of the day (0-23) when the latest occupant typically goes to sleep."
                        },
                        "end_hour": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23,
                            "description": "Hour of the day (0-23) when the earliest occupant typically wakes up."
                        }
                    },
                    "required": [
                        "start_hour",
                        "end_hour"
                    ]
                }
            },
            "required": [
                "num_occupants",
                "household_composition",
                "weekday_pattern",
                "weekend_pattern",
                "sleep_time"
            ]
        },
        "lighting": {
            "type": "object",
            "description": "The lighting usage profile of the household.",
            "properties": {
                "when_house_empty": {
                    "type": "boolean",
                    "description": "TRUE if lights are turned off when the entire household leaves."
                },
                "when_daylight_bright": {
                    "type": "boolean",
                    "description": "TRUE if lights are turned off when natural daylight is sufficient."
                }   
            },
            "required": [
                "when_house_empty",
                "when_daylight_bright"
            ]
        },
        "hvac": {
            "type": "object",
            "description": "The HVAC usage profile of the household.",
            "properties": {
                "heating": {
                    "description": "Heating system control configuration. Can be null if no heating exists.",
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "description": "Type 1: No Occupant Control. System runs on building logic.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "no_control"
                                }
                            },
                            "required": [
                                "type"
                            ]
                        },
                        {
                            "description": "Type 2: Binary Control. Occupant can only switch heating On or Off.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "binary"
                                },
                                "active": {
                                    "type": "boolean",
                                    "description": "Is system ON when active?"
                                },
                                "sleep": {
                                    "type": "boolean",
                                    "description": "Is system ON during sleep?"
                                },
                                "absent": {
                                    "type": "boolean",
                                    "description": "Is system ON during absence?"
                                }
                            },
                            "required": [
                                "type",
                                "active",
                                "sleep",
                                "absent"
                            ]
                        },
                        {
                            "description": "Type 3: Valve Control. Occupant sets intensity level.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "valve"
                                },
                                "active_level": {
                                    "type": "string",
                                    "enum": ["off", "low", "medium", "high", "fullon"],
                                    "description": "Intensity level when occupants are active: off (0%), low (~25%), medium (~50%), high (~75%), fullon (100%)"
                                },
                                "sleep_level": {
                                    "type": "string",
                                    "enum": ["off", "low", "medium", "high", "fullon"],
                                    "description": "Intensity level during sleep: off (0%), low (~25%), medium (~50%), high (~75%), fullon (100%)"
                                },
                                "absent_level": {
                                    "type": "string",
                                    "enum": ["off", "low", "medium", "high", "fullon"],
                                    "description": "Intensity level when absent: off (0%), low (~25%), medium (~50%), high (~75%), fullon (100%)"
                                }
                            },
                            "required": [
                                "type",
                                "active_level",
                                "sleep_level",
                                "absent_level"
                            ]
                        },
                        {
                            "description": "Type 4: Thermostat Control. Occupant sets temperature targets.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "thermostat"
                                },
                                "active_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                },
                                "sleep_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                },
                                "absent_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                }
                            },
                            "required": [
                                "type",
                                "active_setpoint",
                                "sleep_setpoint",
                                "absent_setpoint"
                            ]
                        }
                    ]
                },
                "cooling": {
                    "description": "Cooling system control configuration. Can be null if no cooling exists.",
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "description": "Type 1: No Occupant Control.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "no_control"
                                }
                            },
                            "required": [
                                "type"
                            ]
                        },
                        {
                            "description": "Type 2: Binary Control. Occupant can only switch AC On or Off.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "binary"
                                },
                                "active": {
                                    "type": "boolean",
                                    "description": "Is system ON when active?"
                                },
                                "sleep": {
                                    "type": "boolean",
                                    "description": "Is system ON during sleep?"
                                },
                                "absent": {
                                    "type": "boolean",
                                    "description": "Is system ON during absence?"
                                }
                            },
                            "required": [
                                "type",
                                "active",
                                "sleep",
                                "absent"
                            ]
                        },
                        {
                            "description": "Type 3: Thermostat Control. Occupant sets temperature targets.",
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "thermostat"
                                },
                                "active_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                },
                                "sleep_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                },
                                "absent_setpoint": {
                                    "anyOf": [
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Target Temp C. If null, system is OFF."
                                }
                            },
                            "required": [
                                "type",
                                "active_setpoint",
                                "sleep_setpoint",
                                "absent_setpoint"
                            ]
                        }
                    ]
                }
            }
        },
        "equipment": {
            "type": "object",
            "description": "The equipment usage profile of the household.",
            "properties": {
                "laundry": {
                    "type": "object",
                    "description": "Laundry usage profile.",
                    "properties": {
                        "has_washer": {
                            "type": "boolean",
                            "description": "Indicates whether the household has a washer."
                        },
                        "washer_efficient": {
                            "type": "boolean",
                            "description": "Indicates whether the household has an efficient washer."
                        },
                        "has_dryer": {
                            "type": "boolean",
                            "description": "Indicates whether the household has a dryer."
                        },
                        "dryer_efficient": {
                            "type": "boolean",
                            "description": "Indicates whether the household has an efficient dryer."
                        },
                        "usage_frequency_per_week": {
                            "type": "object",
                            "description": "Frequency of laundry usage per week.",
                            "properties": {
                                "min": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Lower bound of laundry usage frequency per week."
                                },
                                "max": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Upper bound of laundry usage frequency per week."
                                }
                            }
                        }
                    },
                    "required": [
                        "has_washer",
                        "has_dryer"
                    ]
                },
                "refrigerator": {
                    "type": "object",
                    "description": "Refrigerator usage profile.",
                    "properties": {
                        "has_refrigerator": {
                            "type": "boolean",
                            "description": "Indicates whether the household has a refrigerator."
                        },
                        "efficient_refrigerator": {
                            "type": "boolean",
                            "description": "Indicates whether the household has an efficient refrigerator."
                        },
                        "size": {
                            "type": "string",
                            "description": "Size of the refrigerator.",
                            "enum": [
                                "mini",
                                "small",
                                "medium",
                                "large"
                            ]
                        }
                    },
                    "required": [
                        "has_refrigerator"
                    ]
                },
                "dishwasher": {
                    "type": "object",
                    "description": "Dishwasher usage profile.",
                    "properties": {
                        "has_dishwasher": {
                            "type": "boolean",
                            "description": "Indicates whether the household has a dishwasher."
                        },
                        "efficient_dishwasher": {
                            "type": "boolean",
                            "description": "Indicates whether the household has an efficient dishwasher."
                        },
                        "usage_frequency_per_week": {
                            "type": "object",
                            "description": "Frequency of dishwasher usage per week.",
                            "properties": {
                                "min": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Lower bound of dishwasher usage frequency per week."
                                },
                                "max": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Upper bound of dishwasher usage frequency per week."
                                }
                            }
                        }
                    },
                    "required": [
                        "has_dishwasher"
                    ]
                },
                "kitchen": {
                    "type": "object",
                    "description": "Kitchen equipment usage profile.",
                    "properties": {
                        "has_kitchen_equipment": {
                            "type": "boolean",
                            "description": "Indicates whether the household has kitchen equipment."
                        },
                        "cooktop_fuel": {
                            "type": "string",
                            "description": "Fuel type of the cooktop.",
                            "enum": [
                                "electric",
                                "gas",
                                "other"
                            ]
                        },
                        "efficient": {
                            "type": "boolean",
                            "description": "Indicates whether the household has efficient kitchen equipment."
                        },
                        "usage_frequency_per_week": {
                            "type": "object",
                            "description": "Frequency of kitchen equipment usage per week.",
                            "properties": {
                                "min": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Lower bound of kitchen equipment usage frequency per week."
                                },
                                "max": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Upper bound of kitchen equipment usage frequency per week."
                                }
                            }
                        }
                    },
                    "required": [
                        "has_kitchen_equipment"
                    ]
                }
            }
        }
    }
}